{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redline",
  "version": "../package.json",
  "identifier": "io.github.odonckers.redline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Redline",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "A Linear-style client for Redmine",
    "longDescription": "Redline is a fast, keyboard-first desktop client for any Redmine server.",
    "copyright": "Copyright 2026 Owen Donckers and Redline contributors",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
